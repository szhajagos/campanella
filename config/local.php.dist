<?php

declare(strict_types=1);

/*
 * The settings of this installation. Copy this file to config/local.php and fill in
 * your hosting details; local.php is not under version control, and it is never
 * overwritten by an upgrade.
 *
 * How it works: config/app.php has every setting with its default; what you write
 * here replaces it, key by key (you only write what you change). A list, e.g.
 * 'roles' => ['administrator'], replaces the default list whole.
 *
 * Only `database` (and `debug`) are active below; everything else is commented out
 * with its default value: remove the // in front of the lines you need. Some values
 * can also come from environment variables (e.g. in Docker): those are named; a
 * value written here wins over them.
 *
 * Many things are not set here but in the admin: the site's name, address and
 * front page (System → Site settings), the layouts, regions and colour schemes
 * (Appearance). The documentation: docs/deployment.md (a public server),
 * docs/php-api/09-system.md (every key).
 */
return [
    // ------------------------------------------------------------------------------
    // Debug mode. true shows error details to EVERY visitor: only on your own machine,
    // never on a public server (the admin's System page warns while it is on).
    // Environment variable: CAMPANELLA_DEBUG.
    'debug' => false,

    // ------------------------------------------------------------------------------
    // The database (MariaDB 10.6+ or MySQL 8.0+). `prefix` is put before every table's
    // name, so several sites can share one database (each with its own prefix).
    // Environment variables: CAMPANELLA_DB_HOST, _PORT, _NAME, _USER, _PASSWORD, _PREFIX.
    'database' => [
        'host' => 'localhost',
        'port' => 3306,
        'name' => 'campanella',
        'user' => 'campanella',
        'password' => 'secret-password',
        'prefix' => 'cc_',
    ],

    // ------------------------------------------------------------------------------
    // Installing from the browser (/install) needs a key of at least 20 characters,
    // e.g. the output of:  php -r "echo bin2hex(random_bytes(20));"
    // Remove it once the site is installed. (On the command line: php bin/campanella install.)
    // 'install' => ['key' => ''],

    // Upgrading from the browser (/admin/upgrade) works for a logged-in administrator.
    // If logging in does not work until the upgrade has run, set a key of at least 20
    // characters, open /admin/upgrade with it, then remove it. See docs/upgrading.md.
