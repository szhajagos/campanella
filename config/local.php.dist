    //   'dsn' => 'smtps://user:password@smtp.example.hu:465'  SMTP over TLS
    //   'dsn' => 'native://default'                            PHP's own (sendmail_path), like mail()
    //   'dsn' => 'smtp://mailpit:1025'                          a local test catcher (e.g. in Docker)
