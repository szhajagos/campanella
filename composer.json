{
    "name": "campanella/campanella",
    "description": "Campanella – a capability-driven CMS",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "symfony/html-sanitizer": "^7.3",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "Campanella\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Campanella\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "analyse": "phpstan analyse",
        "docs:check": "php tests/docs-check.php",
        "docs:links": "php tests/links-check.php",
        "lang:check": "php tests/lang-check.php"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    }
}
