{
    "name": "campanella/campanella",
    "description": "Campanella – capability-vezérelt CMS",
    "type": "project",
    "version": "0.0.1",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "Campanella\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Campanella\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "analyse": "phpstan analyse",
        "docs:check": "php tests/docs-check.php"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    }
}
