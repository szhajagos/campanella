<!doctype html>
<html lang="{{ site.language|default('hu') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title is defined and title ? title ~ ' – ' : '' }}{{ site.name }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('campanella.css') }}">
</head>
<body>
    <header class="site-header">
        <div class="wrap">
            <a class="site-name" href="{{ url('/') }}">{{ site.name }}</a>
            <nav class="site-nav" aria-label="Főmenü">
                <a href="{{ url('/') }}">Főoldal</a>
                <a href="{{ url('/hirek') }}">Hírek</a>
                <a href="{{ url('/kategoriak') }}">Kategóriák</a>
                <a href="{{ url('/rolunk') }}">Rólunk</a>
            </nav>
            {% set user = current_user() %}
            <div class="site-user">
                {% if user %}
                    <span class="site-user__name">{{ user.title }}</span>
                    <form method="post" action="{{ url('/kilepes') }}" class="inline-form">
                        {{ csrf_field() }}
                        <button type="submit" class="link-button">Kilépés</button>
                    </form>
                {% else %}
                    <a href="{{ url('/belepes') }}">Belépés</a>
                {% endif %}
            </div>
        </div>
    </header>

    <main class="wrap">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="wrap">Campanella {{ campanella_version }}</div>
    </footer>
</body>
</html>
