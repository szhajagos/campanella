<!doctype html>
{% set mode = color_mode() %}
<html lang="{{ locale() }}"{% if mode %} data-bs-theme="{{ mode }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title is defined and title ? title ~ ' – ' : '' }}{{ site.name }}{% endblock %}</title>
{% block meta %}{# Meta description, canonical URL, Open Graph (since 0.1.1): pages that have them pass `meta`. #}{% if meta is defined and meta %}{% include 'page/_meta.html.twig' %}{% endif %}{% endblock %}
    {# The colour mode: the site's or the visitor's own (since 0.3.6), else theme.js follows the system setting. #}
    <script src="{{ asset('theme.js') }}"></script>
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('campanella.css') }}">
    {# The site's colour scheme (since 0.3.6). #}
    <link rel="stylesheet" href="{{ color_scheme_url() }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
    {#- Straight to the content, for the keyboard (since 0.4.0): seen only when it has the focus. #}
    <a class="visually-hidden-focusable site-skip" href="#main">{{ t('site.skip_to_content') }}</a>
    {#- The page's own content (the block a page or a theme fills), placed by the layout. #}
    {%- set main %}{% block content %}{% endblock %}{% endset %}
    {%- set campanella_layout = page_layout() %}
    {%- if campanella_layout %}
    {#- The layout (since 0.3.4): its regions, with the components placed in them. #}
    {{ include(campanella_layout.template, {main: main, layout: campanella_layout}) }}
    {%- else %}
    {#- Until the site's header and footer are components (the upgrade to 0.3.4 makes them): as before. #}
    <header class="site-header border-bottom">
        <nav class="navbar navbar-expand-md" aria-label="{{ t('site.nav.label') }}">
            <div class="container site-container">
                <a class="navbar-brand site-name" href="{{ url('/') }}">{{ site.name }}</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-nav"
                        aria-controls="site-nav" aria-expanded="false" aria-label="{{ t('site.nav.toggle') }}">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="site-nav">
                    {# The main menu (edited in the admin); until it exists, the built-in links. #}
                    {% set main_menu = menu('main') %}
                    <ul class="navbar-nav me-auto">
                        {%- if main_menu is not null %}
                            {%- for item in main_menu %}
                                {%- if item.children %}
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle{{ item.active ? ' active' }}" href="#" role="button"
                                           data-bs-toggle="dropdown" aria-expanded="false">{{ item.title }}</a>
                                        <ul class="dropdown-menu">
                                            {# The item's own page comes first in its dropdown. #}
                                            {%- if not (item.href starts with '#') %}
                                                <li><a class="dropdown-item{{ item.current ? ' active' }}" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                            {%- endif %}
                                            {%- for child in item.children %}
                                                <li><a class="dropdown-item{{ child.current ? ' active' }}" href="{{ child.href }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                                            {%- endfor %}
                                        </ul>
                                    </li>
                                {%- else %}
                                    <li class="nav-item"><a class="nav-link{{ item.current ? ' active' }}" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
                                {%- endif %}
                            {%- endfor %}
                        {%- else %}
                            <li class="nav-item"><a class="nav-link" href="{{ url('/') }}">{{ t('site.nav.home') }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ url(content_path('news')) }}">{{ t('site.nav.news') }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ url(content_path('categories')) }}">{{ t('site.nav.categories') }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ url(content_path('about')) }}">{{ t('site.nav.about') }}</a></li>
                        {%- endif %}
                    </ul>
                    {# The search (since 0.2.7). #}
                    <form method="get" action="{{ path('search') }}" class="site-search d-flex ms-md-auto me-md-3 my-2 my-md-0" role="search">
                        <label for="site-search-q" class="visually-hidden">{{ t('search.label') }}</label>
                        <input type="search" class="form-control form-control-sm" id="site-search-q" name="q" maxlength="200" placeholder="{{ t('search.placeholder') }}">
                    </form>
                    {% set user = current_user() %}
                    <div class="site-user d-flex align-items-center gap-3">
                        {% if user %}
                            {% if admin_access() %}<a class="btn btn-sm btn-primary" href="{{ admin_url() }}">{{ t('admin.link') }}</a>{% endif %}
                            <span class="site-user__name text-body-secondary">{{ user.title }}</span>
                            <form method="post" action="{{ path('logout') }}" class="m-0">
                                {{ csrf_field() }}
                                <button type="submit" class="btn btn-sm btn-outline-secondary">{{ t('auth.logout') }}</button>
                            </form>
                        {% else %}
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('login') }}">{{ t('auth.login') }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container site-container flex-grow-1 py-4 py-md-5" id="main" tabindex="-1">
        {{ main }}
    </main>

    <footer class="site-footer border-top py-3 small text-body-secondary">
        <div class="container site-container">Campanella {{ campanella_version }}</div>
    </footer>
    {%- endif %}

    <script src="{{ asset('vendor/bootstrap/js/bootstrap.bundle.min.js') }}" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
