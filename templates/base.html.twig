<!doctype html>
<html lang="{{ locale() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title is defined and title ? title ~ ' – ' : '' }}{{ site.name }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('campanella.css') }}">
</head>
<body>
    <header class="site-header">
        <div class="wrap">
            <a class="site-name" href="{{ url('/') }}">{{ site.name }}</a>
            <nav class="site-nav" aria-label="{{ t('site.nav.label') }}">
                <a href="{{ url('/') }}">{{ t('site.nav.home') }}</a>
                <a href="{{ url('/hirek') }}">{{ t('site.nav.news') }}</a>
                <a href="{{ url('/kategoriak') }}">{{ t('site.nav.categories') }}</a>
                <a href="{{ url('/rolunk') }}">{{ t('site.nav.about') }}</a>
            </nav>
            {% set user = current_user() %}
            <div class="site-user">
                {% if user %}
                    <span class="site-user__name">{{ user.title }}</span>
                    <form method="post" action="{{ url('/kilepes') }}" class="inline-form">
                        {{ csrf_field() }}
                        <button type="submit" class="link-button">{{ t('auth.logout') }}</button>
                    </form>
                {% else %}
                    <a href="{{ url('/belepes') }}">{{ t('auth.login') }}</a>
                {% endif %}
            </div>
        </div>
    </header>

    <main class="wrap">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="wrap">Campanella {{ campanella_version }}</div>
    </footer>
</body>
</html>
