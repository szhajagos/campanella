<!doctype html>
<html lang="{{ site.language|default('hu') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title is defined and title ? title ~ ' – ' : '' }}{{ site.name }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('campanella.css') }}">
</head>
<body>
    <header class="site-header">
        <div class="wrap">
            <a class="site-name" href="{{ url('/') }}">{{ site.name }}</a>
            <nav class="site-nav" aria-label="Főmenü">
                <a href="{{ url('/') }}">Főoldal</a>
                <a href="{{ url('/hirek') }}">Hírek</a>
                <a href="{{ url('/rolunk') }}">Rólunk</a>
            </nav>
        </div>
    </header>

    <main class="wrap">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="wrap">Campanella {{ campanella_version }}</div>
    </footer>
</body>
</html>
