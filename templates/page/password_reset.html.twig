{% extends 'base.html.twig' %}

{# The forgotten password (since 0.1.4). step: request, sent, new, invalid. #}
{% block content %}
    <section class="login mx-auto">
        <h1 class="h3 mb-4">{{ step == 'new' ? t('auth.reset.new_title') : t('auth.reset.title') }}</h1>

        {% if error %}
            <div class="alert alert-danger" role="alert">{{ t(error.key, error.params) }}</div>
        {% endif %}

        {% if step == 'request' %}
            <form method="post" action="{{ path('password_reset') }}" class="card card-body shadow-sm">
                <p>{{ t('auth.reset.intro') }}</p>
                {{ csrf_field() }}
                {{ guard_fields|raw }}
                <div class="mb-4">
                    <label for="email" class="form-label">{{ t('auth.email') }}</label>
                    <input type="email" class="form-control" id="email" name="email" value="{{ email }}" autocomplete="username" required autofocus>
                </div>
                <button type="submit" class="btn btn-primary w-100">{{ t('auth.reset.send') }}</button>
            </form>
            <p class="mt-3 text-center"><a href="{{ path('login') }}">{{ t('auth.reset.back') }}</a></p>

        {% elseif step == 'sent' %}
            <div class="card card-body shadow-sm" role="status">
                <p class="mb-2">{{ t('auth.reset.sent', {minutes: minutes}) }}</p>
                <p class="small text-body-secondary mb-0">{{ t('auth.reset.sent_help') }}</p>
            </div>
            <p class="mt-3 text-center"><a href="{{ path('login') }}">{{ t('auth.reset.back') }}</a></p>

        {% elseif step == 'new' %}
            <form method="post" action="{{ path('password_reset') }}" class="card card-body shadow-sm" novalidate>
                {{ csrf_field() }}
                {# For password managers: the account's name is not shown, so as not to reveal it to someone else who opens the link. #}
                {% set invalid = errors.password ?? null %}
                <div class="mb-3">
                    <label for="password" class="form-label">{{ t('users.new_password') }}</label>
                    <input type="password" class="form-control{{ invalid ? ' is-invalid' }}" id="password" name="password" autocomplete="new-password" required autofocus
                           aria-describedby="password-help{{ invalid ? ' password-error' }}">
                    <div class="form-text" id="password-help">{{ t('users.password_help', {min: min_password}) }}</div>
                    {% if invalid %}<div class="invalid-feedback" id="password-error">{{ t(invalid.key, invalid.params) }}</div>{% endif %}
                </div>
                {% set invalid = errors.password_again ?? null %}
                <div class="mb-4">
                    <label for="password_again" class="form-label">{{ t('users.password_again') }}</label>
                    <input type="password" class="form-control{{ invalid ? ' is-invalid' }}" id="password_again" name="password_again" autocomplete="new-password" required
                           {% if invalid %}aria-describedby="password-again-error"{% endif %}>
                    {% if invalid %}<div class="invalid-feedback" id="password-again-error">{{ t(invalid.key, invalid.params) }}</div>{% endif %}
                </div>
                <p class="small text-body-secondary">{{ t('auth.reset.new_help') }}</p>
                <button type="submit" class="btn btn-primary w-100">{{ t('auth.reset.save') }}</button>
            </form>

        {% else %}
            <div class="alert alert-warning" role="alert">{{ t('auth.reset.invalid') }}</div>
            <p class="text-center"><a href="{{ path('password_reset') }}?again=1">{{ t('auth.reset.request_again') }}</a></p>
        {% endif %}
    </section>
{% endblock %}
