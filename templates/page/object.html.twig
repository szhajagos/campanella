{% extends 'base.html.twig' %}

{% block content %}
    {{ render_object(object, 'full') }}

    {# The Blueprint's 'lists', e.g. the articles of a category. #}
    {% for name, list in lists %}
        <section class="object-list object-list--{{ name }}">
            {% if list.label %}<h2 class="object-list__title">{{ list.label }}</h2>{% endif %}
            {% for item in list.result %}
                {{ render_object(item, 'teaser') }}
            {% else %}
                <p class="empty">Nincs megjeleníthető tartalom.</p>
            {% endfor %}
        </section>
    {% endfor %}
{% endblock %}
