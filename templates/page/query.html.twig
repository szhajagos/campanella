{% extends 'base.html.twig' %}

{% block content %}
    {% if title %}
        <h1 class="page-title mb-4">{{ title }}</h1>
    {% else %}
        <section class="intro mb-4 pb-3 border-bottom">
            <h1>{{ site.name }}</h1>
            <p class="lead text-body-secondary mb-0">{{ site.slogan }}</p>
        </section>
    {% endif %}
    {{ content|raw }}
{% endblock %}
