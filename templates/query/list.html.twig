{# The result of a Query as a list. Custom variant: query/<query-name>.html.twig #}
<div class="result result--{{ name }}">
    {% for item in result %}
        {{ render_object(item, item_mode) }}
    {% else %}
        <p class="empty text-body-secondary">{{ t('content.empty') }}</p>
    {% endfor %}
</div>

{% if result.pageCount > 1 %}
    <nav class="pager mt-4" aria-label="{{ t('content.pager') }}">
        <ul class="pagination">
            {% for page in 1..result.pageCount %}
                {% if page == result.currentPage %}
                    <li class="page-item active" aria-current="page"><span class="page-link">{{ page }}</span></li>
                {% else %}
                    <li class="page-item"><a class="page-link" href="{{ url(path) }}?page={{ page }}">{{ page }}</a></li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
{% endif %}
