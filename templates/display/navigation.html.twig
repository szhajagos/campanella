{# The navigation display (since 0.3.3): a menu's items (entries: MenuEntry), as a bar with dropdowns or as a list. #}
{% macro items(entries) %}
    <ul class="nav flex-column">
        {%- for item in entries %}
            <li class="nav-item">
                <a class="nav-link{{ item.current ? ' active' }}" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a>
                {%- if item.children %}<div class="ms-3">{{ _self.items(item.children) }}</div>{% endif %}
            </li>
        {%- endfor %}
    </ul>
{% endmacro %}
<nav class="display-navigation display-navigation--{{ settings.style }} menu--{{ object.machine_name }}" aria-label="{{ object.title }}">
    {%- if settings.style == 'vertical' %}
        {{ _self.items(entries) }}
    {%- else %}
        <ul class="nav">
            {%- for item in entries %}
                {%- if item.children %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle{{ item.active ? ' active' }}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">{{ item.title }}</a>
                        <ul class="dropdown-menu">
                            {%- if not (item.href starts with '#') %}
                                <li><a class="dropdown-item{{ item.current ? ' active' }}" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
                                <li><hr class="dropdown-divider"></li>
                            {%- endif %}
                            {%- for child in item.children %}
                                <li><a class="dropdown-item{{ child.current ? ' active' }}" href="{{ child.href }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                            {%- endfor %}
                        </ul>
                    </li>
                {%- else %}
                    <li class="nav-item"><a class="nav-link{{ item.current ? ' active' }}" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
                {%- endif %}
            {%- endfor %}
        </ul>
    {%- endif %}
</nav>
