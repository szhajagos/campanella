{# To the user whose password changed (the MailUser action, when bound; since 0.1.4). #}
{% block subject %}{{ t('mail.user.password_changed.subject', {site: site.name}) }}{% endblock %}
{% block body %}{% autoescape false %}
{{ to_name ? t('mail.greeting', {name: to_name}) : t('mail.greeting_anonymous') }}

{{ t(by_administrator ? 'mail.user.password_changed.by_administrator' : (by_reset ? 'mail.user.password_changed.by_reset' : 'mail.user.password_changed.by_you'), {site: site.name}) }}
{{ t('mail.event.at', {time: occurred_at}) }}

{{ t('mail.user.password_changed.not_you') }}
{% if reset_link %}{{ reset_link }}
{% endif %}
{% include 'mail/_footer.txt.twig' %}
{% endautoescape %}{% endblock %}
