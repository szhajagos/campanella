{# The core layouts' top (since 0.3.4): the header region (always seen), the navigation beside it.
   Not a <nav> itself (since 0.4.0): the menus in it are (the navigation display), so they are not nested in another. #}
<header class="site-header border-bottom">
    <div class="navbar">
        <div class="container site-container d-flex flex-wrap align-items-center gap-2">
            {{ region('header', {class: 'me-auto'}) }}
            {{ region('navigation', {row: true, class: 'flex-grow-1'}) }}
        </div>
    </div>
</header>
