{# An upload form: images (the Images list), files to download (the Files list, since 0.3.2), or
   either (the media library). Without JavaScript one file at a time (the server redirects back);
   with admin-upload.js several, chosen or dropped, each reported. A file's visibility is sent with it. #}
{% set kind = kind ?? 'image' %}
<form method="post" action="{{ url(upload.url) }}" enctype="multipart/form-data" class="card card-body mb-4 admin-upload" data-media-upload
      data-upload-max="{{ upload.max }}" data-upload-too-large="{{ t(kind == 'image' ? 'media.too_large' : 'file.too_large', {max: upload.max_mb}) }}"
      data-upload-session="{{ t('media.session_expired') }}" data-uploading="{{ t('admin.media.uploading') }}"
      data-failed="{{ t('admin.media.failed') }}" data-show-uploaded="{{ t(kind == 'image' ? 'admin.media.show_uploaded' : 'admin.files.show_uploaded') }}">
    {{ csrf_field() }}
    <label for="upload-file" class="form-label fw-semibold">{{ t({image: 'admin.media.upload', file: 'admin.files.upload', any: 'admin.library.upload'}[kind]) }}</label>
    <div class="d-flex flex-wrap gap-2">
        <input type="file" class="form-control flex-grow-1" id="upload-file" name="file" required
               accept="{{ kind == 'image' ? 'image/jpeg,image/png,image/webp,image/gif' : upload.accept }}" aria-describedby="upload-hint">
        <button type="submit" class="btn btn-primary" data-upload-submit>{{ t('admin.files.send') }}</button>
    </div>
    <div class="form-text" id="upload-hint">
        {%- if kind == 'image' -%}
            {{ t('admin.media.upload_hint', {max: upload.max_mb}) }}
        {%- elseif kind == 'file' -%}
            {{ t('admin.files.upload_hint', {types: upload.types, max: upload.max_mb}) }}
        {%- else -%}
            {{ t(upload.files ? 'admin.library.upload_hint' : 'admin.media.upload_hint', {types: upload.types, max: upload.max_mb}) }}
        {%- endif -%}
    </div>
    {% if kind != 'image' and upload.files %}
        <fieldset class="mt-3 admin-upload__visibility" data-visibility>
            <legend class="form-label fw-semibold fs-6 mb-1">{{ t(kind == 'any' ? 'admin.files.visible_to_files' : 'field.visible_to') }}</legend>
            <div class="d-flex flex-wrap gap-3">
                {% for scope in ['public', 'users', 'roles'] %}
                    {% if scope != 'roles' or upload.roles %}
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="visible_to" id="upload-visible-{{ scope }}" value="{{ scope }}"{{ loop.first ? ' checked' }}>
                            <label class="form-check-label" for="upload-visible-{{ scope }}">{{ t('restricted.' ~ scope) }}</label>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% if upload.roles %}
                <div class="d-flex flex-wrap gap-3 mt-1 ms-4" data-visibility-roles>
                    {% for role in upload.roles %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="visible_roles[]" id="upload-role-{{ role.value }}" value="{{ role.value }}">
                            <label class="form-check-label" for="upload-role-{{ role.value }}">{{ role.label }}</label>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </fieldset>
    {% endif %}
    <div class="mt-2" data-upload-status role="status" aria-live="polite"></div>
</form>
