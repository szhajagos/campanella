{% extends '@core/admin/base.html.twig' %}

{# The e-mails sent (or tried), newest first (since 0.1.3). #}
{% set badges = {sent: 'text-bg-success', failed: 'text-bg-danger', not_configured: 'text-bg-light border'} %}

{% block content %}
    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
        <h1 class="h3 mb-0">{{ t('mail.log.title') }}</h1>
        {% if configured %}
            <form method="post" action="{{ admin_url('system/mail-test') }}" class="m-0">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-sm btn-outline-primary">{{ t('admin.system.mail_test') }}</button>
            </form>
        {% endif %}
    </div>

    <p class="text-body-secondary">
        {% if configured %}
            {{ t('mail.log.configured', {transport: transport, from: from}) }}
        {% else %}
            {{ t('admin.system.mail_off_hint') }}
        {% endif %}
        {{ t('mail.log.kept') }}
    </p>

    {% if entries %}
        <div class="table-responsive">
            <table class="table table-sm align-middle admin-list">
                <thead>
                    <tr>
                        <th scope="col">{{ t('mail.log.time') }}</th>
                        <th scope="col">{{ t('mail.log.recipient') }}</th>
                        <th scope="col">{{ t('mail.log.subject') }}</th>
                        <th scope="col">{{ t('mail.log.status') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                        <tr>
                            <td class="small text-nowrap">{{ entry.created_at }} UTC</td>
                            <td class="small text-break">{{ entry.recipient }}</td>
                            <td class="small">
                                {{ entry.subject ?: '–' }}
                                <span class="text-body-secondary">({{ entry.template }})</span>
                                {% if entry.error %}<div class="small text-danger-emphasis text-break">{{ entry.error }}</div>{% endif %}
                            </td>
                            <td><span class="badge {{ badges[entry.status] ?? 'text-bg-secondary' }}">{{ t('mail.status.' ~ entry.status) }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-body-secondary">{{ t('mail.log.empty') }}</p>
    {% endif %}
{% endblock %}
