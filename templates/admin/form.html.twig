{% extends '@core/admin/base.html.twig' %}

{% block content %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-2">
            <li class="breadcrumb-item"><a href="{{ url(list_path) }}">{{ t(blueprint.label) }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ object.isNew ? t('admin.form.new_short') : '#' ~ object.id }}</li>
        </ol>
    </nav>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0 me-2">{{ title_text ?? t(title, title_params) }}</h1>
        {% include '@core/admin/_status.html.twig' with {object: object} only %}
        {% if not object.isNew and object.path is defined and object.path %}
            <a class="small ms-auto" href="{{ url(object.path) }}" target="_blank" rel="noopener">{{ t('admin.list.view') }}</a>
        {% endif %}
    </div>

    {% if alert %}
        <div class="alert {{ alert == 'admin.form.conflict' ? 'alert-warning' : 'alert-danger' }}" role="alert">{{ t(alert) }}</div>
    {% endif %}
    {% for name, error in other_errors %}
        <div class="alert alert-danger" role="alert">{{ name }}: {{ t(error.key, error.params) }}</div>
    {% endfor %}

    <div class="row g-4">
        <div class="{{ publication or can_delete ? 'col-lg-8' : 'col-12' }}">
            <form method="post" action="{{ url(action) }}" class="admin-form" novalidate
                {%- if upload and has_editor %} data-upload-url="{{ url(upload.url) }}" data-upload-max="{{ upload.max }}"
                    data-upload-too-large="{{ t('media.too_large', {max: upload.max_mb}) }}"
                    data-upload-session="{{ t('media.session_expired') }}"{% endif %}>
                {{ csrf_field() }}
                {% if version %}<input type="hidden" name="_version" value="{{ version }}">{% endif %}

                {% for field in fields %}
                    {% include '@core/admin/form/_row.html.twig' with {field: field} only %}
                {% endfor %}

                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary">{{ t(object.isNew ? 'admin.form.create' : 'admin.form.save') }}</button>
                    {% if can_publish_new %}
                        <button type="submit" class="btn btn-success" name="_publish" value="1">{{ t('admin.form.create_publish') }}</button>
                    {% endif %}
                    <a class="btn btn-outline-secondary" href="{{ url(list_path) }}">{{ t('admin.form.cancel') }}</a>
                </div>
            </form>

            {% if fields|filter(f => f.attributes.convertible ?? false) is not empty %}
                <form id="convert-html" method="post" action="{{ url(action ~ '/convert-html') }}" class="d-none" data-confirm-unsaved="{{ t('admin.form.unsaved_confirm') }}">
                    {{ csrf_field() }}
                    <input type="hidden" name="_version" value="{{ version }}">
                </form>
            {% endif %}
        </div>

        {% if publication or can_delete %}
            <aside class="col-lg-4">
                {% if publication %}
                    {% include '@core/admin/_publication.html.twig' %}
                {% endif %}
                {% if can_delete %}
                    <a class="btn btn-outline-danger btn-sm" href="{{ url(action ~ '/delete') }}">{{ t('admin.delete.link') }}</a>
                {% endif %}
            </aside>
        {% endif %}
    </div>
{% endblock %}

{% set has_editor = fields|filter(f => f.widget == 'html') is not empty %}

{% block stylesheets %}
    {% if has_editor %}<link rel="stylesheet" href="{{ asset('vendor/jodit/jodit.min.css') }}">{% endif %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('admin.js') }}" defer></script>
    {% if has_editor %}
        <script src="{{ asset('vendor/jodit/jodit.min.js') }}" defer></script>
        <script src="{{ asset('admin-editor.js') }}" defer></script>
    {% endif %}
{% endblock %}
