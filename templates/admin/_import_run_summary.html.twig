{# A run's counts (since 0.3.1). #}
<span class="badge text-bg-{{ run.running ? 'info' : (run.status == 'done' ? (run.failed ? 'warning' : 'success') : 'secondary') }}">{{ t('importers.status.' ~ run.status) }}</span>
<span class="small">{{ t('import.run.summary', {created: run.created, updated: run.updated, unchanged: run.unchanged, failed: run.failed, missing: run.missing}) }}</span>
