{% extends '@core/admin/base.html.twig' %}

{# 1. Choosing a component's source (since 0.3.3). #}
{% block content %}
    {% include '@core/admin/_component_steps.html.twig' with {step: 1} %}
    <h1 class="h3 mb-4">{{ t('components.choose_source') }}</h1>
    {% set next = admin_url(base ~ '/display') ~ '?source=' %}

    <div class="row g-4">
        <section class="col-lg-6" aria-labelledby="source-system">
            <h2 class="h5" id="source-system">{{ t('components.sources.system') }}</h2>
            <div class="list-group mb-4">
                {% for item in systems %}
                    <a class="list-group-item list-group-item-action" href="{{ next ~ item.source|url_encode }}">{{ t(item.label) }}</a>
                {% endfor %}
                <a class="list-group-item list-group-item-action" href="{{ next ~ 'current' }}">{{ t('components.source.current') }}
                    <div class="small text-body-secondary">{{ t('components.source.current_help') }}</div></a>
            </div>

            <h2 class="h5">{{ t('components.sources.lists') }}</h2>
            {% if lists %}
                <div class="list-group">
                    {% for item in lists %}
                        <a class="list-group-item list-group-item-action" href="{{ next ~ item.source|url_encode }}">{{ item.label }} <code class="small text-body-secondary">{{ item.name }}</code></a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-body-secondary">{{ t('components.sources.no_lists') }}</p>
            {% endif %}
        </section>

        <section class="col-lg-6" aria-labelledby="source-object">
            <h2 class="h5" id="source-object">{{ t('components.sources.object') }}</h2>
            <form method="get" action="{{ admin_url(base ~ '/source') }}" class="row g-2 mb-3">
                <div class="col-sm-4">
                    <label class="visually-hidden" for="source-blueprint">{{ t('components.sources.blueprint') }}</label>
                    <select class="form-select" id="source-blueprint" name="blueprint">
                        {% for name, label in blueprints %}<option value="{{ name }}"{{ name == chosen ? ' selected' }}>{{ t(label) }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-sm">
                    <label class="visually-hidden" for="source-q">{{ t('components.sources.search') }}</label>
                    <input type="search" class="form-control" id="source-q" name="q" value="{{ search }}" maxlength="100" placeholder="{{ t('components.sources.search') }}">
                </div>
                <div class="col-sm-auto"><button type="submit" class="btn btn-outline-primary w-100">{{ t('components.sources.find') }}</button></div>
            </form>
            {% if chosen %}
                {% if found %}
                    <div class="list-group">
                        {% for item in found %}
                            <a class="list-group-item list-group-item-action" href="{{ next ~ ('object:' ~ item.id)|url_encode }}">{{ item.title }} <span class="small text-body-secondary">#{{ item.id }}</span></a>
                        {% endfor %}
                    </div>
                    {% if found|length >= max %}<p class="form-text">{{ t('components.sources.more', {max: max}) }}</p>{% endif %}
                {% else %}
                    <p class="text-body-secondary">{{ t('components.sources.none') }}</p>
                {% endif %}
            {% endif %}
        </section>
    </div>
{% endblock %}
