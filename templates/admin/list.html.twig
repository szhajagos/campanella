{% extends '@core/admin/base.html.twig' %}

{# A link to this list with some parameters changed (the page is reset unless given). #}
{% macro list_url(path, filters, changes) %}{{ url(path) }}?{{ filters|merge({page: null})|merge(changes)|filter(v => v is not same as(null) and v != '')|url_encode }}{% endmacro %}

{% macro sort_header(label, field, filters, path, sortable) %}
    {% if field in sortable %}
        {% set current = filters.sort == field %}
        {% set dir = current and filters.dir == 'asc' ? 'desc' : 'asc' %}
        <a class="text-reset text-decoration-none" href="{{ _self.list_url(path, filters, {sort: field, dir: dir}) }}"
           {% if current %}aria-sort="{{ filters.dir == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
            {{ t(label) }}{% if current %} <span aria-hidden="true">{{ filters.dir == 'asc' ? '▲' : '▼' }}</span>{% endif %}
        </a>
    {% else %}
        {{ t(label) }}
    {% endif %}
{% endmacro %}

{% block content %}
    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
        <h1 class="h3 mb-0">{{ t(blueprint.label) }}</h1>
        <div class="d-flex align-items-center gap-3">
            <span class="text-body-secondary small">{{ t('admin.list.total', {count: result.total ?? 0}) }}</span>
            {% if can_create %}<a class="btn btn-sm btn-primary" href="{{ admin_url(blueprint.name ~ '/new') }}">{{ t('admin.list.new') }}</a>{% endif %}
        </div>
    </div>

    {% if upload %}
        {# Images: uploaded right here. Without JavaScript one file at a time (the server redirects back);
           with admin-upload.js several, chosen or dropped, each reported. #}
        <form method="post" action="{{ url(upload.url) }}" enctype="multipart/form-data" class="card card-body mb-4 admin-upload" data-media-upload
              data-upload-max="{{ upload.max }}" data-upload-too-large="{{ t('media.too_large', {max: upload.max_mb}) }}"
              data-upload-session="{{ t('media.session_expired') }}" data-uploading="{{ t('admin.media.uploading') }}"
              data-failed="{{ t('admin.media.failed') }}" data-show-uploaded="{{ t('admin.media.show_uploaded') }}">
            {{ csrf_field() }}
            <label for="upload-file" class="form-label fw-semibold">{{ t('admin.media.upload') }}</label>
            <div class="d-flex flex-wrap gap-2">
                <input type="file" class="form-control flex-grow-1" id="upload-file" name="file" required
                       accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="upload-hint">
                <button type="submit" class="btn btn-primary" data-upload-submit>{{ t('admin.media.upload') }}</button>
            </div>
            <div class="form-text" id="upload-hint">{{ t('admin.media.upload_hint', {max: upload.max_mb}) }}</div>
            <div class="mt-2" data-upload-status role="status" aria-live="polite"></div>
        </form>
    {% endif %}

    <form method="get" action="{{ url(path) }}" class="row g-2 align-items-end mb-3 admin-filters" role="search">
        {% if searchable %}
            <div class="col-sm-6 col-lg-4">
                <label for="filter-q" class="form-label small mb-1">{{ t('admin.list.search') }}</label>
                <input type="search" class="form-control form-control-sm" id="filter-q" name="q" value="{{ filters.q }}">
            </div>
        {% endif %}
        {% if statuses %}
            <div class="col-sm-4 col-lg-3">
                <label for="filter-status" class="form-label small mb-1">{{ t('field.status') }}</label>
                <select class="form-select form-select-sm" id="filter-status" name="status">
                    <option value="">{{ t('admin.list.all') }}</option>
                    {% for status in statuses %}
                        <option value="{{ status }}"{{ filters.status == status ? ' selected' }}>{{ t('admin.status.' ~ status) }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}
        <input type="hidden" name="sort" value="{{ filters.sort }}">
        <input type="hidden" name="dir" value="{{ filters.dir }}">
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">{{ t('admin.list.filter') }}</button>
            {% if filters.q or filters.status %}
                <a class="btn btn-sm btn-link" href="{{ url(path) }}">{{ t('admin.list.reset') }}</a>
            {% endif %}
        </div>
    </form>

    {% if result.isEmpty %}
        <p class="text-body-secondary py-4">{{ filters.q or filters.status ? t('admin.list.no_match') : t('admin.recent_empty') }}</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-list">
                <thead>
                    <tr>
                        {% if is_file %}<th scope="col"><span class="visually-hidden">{{ t('admin.media.preview') }}</span></th>{% endif %}
                        <th scope="col">{{ _self.sort_header(searchable ? 'admin.column.title' : 'admin.column.id', searchable ? 'title' : 'id', filters, path, sortable) }}</th>
                        {% if statuses %}<th scope="col">{{ t('field.status') }}</th>{% endif %}
                        {% if is_file %}<th scope="col">{{ _self.sort_header('field.file_size', 'file_size', filters, path, sortable) }}</th>{% endif %}
                        {% if has_author %}<th scope="col">{{ t('relation.author') }}</th>{% endif %}
                        {% if 'published_at' in sortable %}<th scope="col">{{ _self.sort_header('field.published_at', 'published_at', filters, path, sortable) }}</th>{% endif %}
                        <th scope="col" class="text-end">{{ _self.sort_header('admin.column.updated', 'updated', filters, path, sortable) }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in result %}
                        <tr>
                            {% if is_file %}
                                <td class="admin-thumb-cell">
                                    {% if media[item.id] is defined %}<img class="admin-thumb" src="{{ url(media[item.id]) }}" alt="" width="64" height="64" loading="lazy" decoding="async">{% endif %}
                                </td>
                            {% endif %}
                            <td>
                                {% set label = item.title is defined and item.title ? item.title : t('admin.untitled') %}
                                {% if editable[item.id] ?? false %}
                                    <a class="fw-semibold" href="{{ admin_url(blueprint.name ~ '/' ~ item.id) }}">{{ label }}</a>
                                {% else %}
                                    {{ label }}
                                {% endif %}
                                {% if item.path is defined and item.path %}
                                    <a class="small ms-2" href="{{ url(item.path) }}" target="_blank" rel="noopener">{{ t('admin.list.view') }}</a>
                                {% endif %}
                                {% if is_file and item.alt is defined and not item.alt %}
                                    <div><span class="badge bg-body-tertiary text-body-secondary border fw-normal">{{ t('admin.media.no_alt') }}</span></div>
                                {% endif %}
                            </td>
                            {% if is_file %}
                                <td class="small text-nowrap">
                                    {{ type_names[item.mime_type] ?? item.mime_type }} · {{ item.file_size|file_size }}
                                    {% if item.width and item.height %}<div class="text-body-secondary">{{ t('admin.media.dimensions', {width: item.width, height: item.height}) }}</div>{% endif %}
                                </td>
                            {% endif %}
                            {% if statuses %}<td>{% include '@core/admin/_status.html.twig' with {object: item} only %}</td>{% endif %}
                            {% if has_author %}
                                <td class="small">{% for author in related(item, 'author') %}{{ author.title }}{% else %}<span class="text-body-secondary">–</span>{% endfor %}</td>
                            {% endif %}
                            {% if 'published_at' in sortable %}
                                <td class="small text-body-secondary">{% if item.published_at %}<time datetime="{{ item.published_at|date('c') }}">{{ item.published_at|date }}</time>{% else %}–{% endif %}</td>
                            {% endif %}
                            <td class="text-end small text-body-secondary"><time datetime="{{ item.updated|date('c') }}">{{ item.updated|date }}</time></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if result.pageCount > 1 %}
            <nav aria-label="{{ t('content.pager') }}">
                <ul class="pagination pagination-sm">
                    {% for page in 1..result.pageCount %}
                        {% if page == result.currentPage %}
                            <li class="page-item active" aria-current="page"><span class="page-link">{{ page }}</span></li>
                        {% else %}
                            <li class="page-item"><a class="page-link" href="{{ _self.list_url(path, filters, {page: page}) }}">{{ page }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}

{% block scripts %}
    {{ parent() }}
    {% if upload %}<script src="{{ asset('admin-upload.js') }}" defer></script>{% endif %}
{% endblock %}
