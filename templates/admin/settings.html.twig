{% extends '@core/admin/base.html.twig' %}

{% macro error(errors, name) %}{% if errors[name] ?? null %}<div class="invalid-feedback d-block" id="settings-{{ name }}-error">{{ t(errors[name].key, errors[name].params) }}</div>{% endif %}{% endmacro %}
{% macro invalid(errors, name) %}{{ (errors[name] ?? null) ? ' is-invalid' }}{% endmacro %}
{% macro described(errors, name) %} aria-describedby="settings-{{ name }}-help{{ (errors[name] ?? null) ? ' settings-' ~ name ~ '-error' }}"{% endmacro %}

{% block content %}
    <h1 class="h3 mb-2">{{ t('settings.title') }}</h1>
    <p class="text-body-secondary mb-4">{{ t('settings.intro') }}</p>

    {% if alert ?? null %}<div class="alert alert-danger" role="alert">{{ t(alert) }}</div>{% endif %}

    <form method="post" action="{{ admin_url('system/settings') }}" class="admin-form" novalidate>
        {{ csrf_field() }}
        <div class="row g-4">
            <div class="col-xl-7">
                <section class="card card-body mb-4">
                    <h2 class="h6 mb-3">{{ t('settings.group.site') }}</h2>
                    <div class="mb-3">
                        <label for="settings-name" class="form-label fw-semibold">{{ t('settings.name') }} <span class="text-danger" aria-hidden="true">*</span></label>
                        <input type="text" class="form-control{{ _self.invalid(errors, 'name') }}" id="settings-name" name="name" value="{{ form.name }}" required maxlength="{{ max.name }}"{{ _self.described(errors, 'name') }}>
                        <div class="form-text" id="settings-name-help">{{ t('settings.name_help') }}</div>
                        {{ _self.error(errors, 'name') }}
                    </div>
                    <div class="mb-3">
                        <label for="settings-slogan" class="form-label fw-semibold">{{ t('settings.slogan') }}</label>
                        <input type="text" class="form-control{{ _self.invalid(errors, 'slogan') }}" id="settings-slogan" name="slogan" value="{{ form.slogan }}" maxlength="{{ max.slogan }}"{{ _self.described(errors, 'slogan') }}>
                        <div class="form-text" id="settings-slogan-help">{{ t('settings.slogan_help') }}</div>
                        {{ _self.error(errors, 'slogan') }}
                    </div>
                    <div class="mb-0">
                        <label for="settings-url" class="form-label fw-semibold">{{ t('settings.url') }}</label>
                        <input type="url" class="form-control{{ _self.invalid(errors, 'url') }}" id="settings-url" name="url" value="{{ form.url }}" maxlength="{{ max.url }}" placeholder="https://example.hu" inputmode="url" autocomplete="off"{{ _self.described(errors, 'url') }}>
                        <div class="form-text" id="settings-url-help">
                            {% if form.url == '' and not (errors.url ?? null) %}<span class="d-block text-warning-emphasis fw-semibold">{{ t('settings.url_missing') }}</span>{% endif %}
                            {{ t('settings.url_help') }}
                            {% if origin and origin != form.url %}{{ t('settings.url_origin', {origin: origin}) }}{% endif %}
                        </div>
                        {{ _self.error(errors, 'url') }}
                    </div>
                </section>

                <section class="card card-body mb-4">
                    <h2 class="h6 mb-3">{{ t('settings.group.search') }}</h2>
                    <div class="mb-3">
                        <label for="settings-description" class="form-label fw-semibold">{{ t('settings.description') }}</label>
                        <textarea class="form-control{{ _self.invalid(errors, 'description') }}" id="settings-description" name="description" rows="3" maxlength="{{ max.description }}"{{ _self.described(errors, 'description') }}>{{ form.description }}</textarea>
                        <div class="form-text" id="settings-description-help">{{ t('settings.description_help') }}</div>
                        {{ _self.error(errors, 'description') }}
                    </div>
                    <div class="mb-0">
                        <input type="hidden" name="indexing" value="0">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="settings-indexing" name="indexing" value="1"{{ form.indexing ? ' checked' }} aria-describedby="settings-indexing-help">
                            <label class="form-check-label fw-semibold" for="settings-indexing">{{ t('settings.indexing') }}</label>
                        </div>
                        <div class="form-text" id="settings-indexing-help">{{ t('settings.indexing_help') }}</div>
                    </div>
                </section>
            </div>

            <div class="col-xl-5">
                <section class="card card-body mb-4">
                    <h2 class="h6 mb-3">{{ t('settings.group.sharing') }}</h2>
                    {% set selected = null %}
                    {% for image in images %}{% if form.share_image == image.id ~ '' %}{% set selected = image %}{% endif %}{% endfor %}
                    {% if selected %}
                        <img src="{{ url(selected.url) }}" alt="" class="img-fluid rounded border mb-3 settings-share-preview">
                    {% endif %}
                    <label for="settings-share_image" class="form-label fw-semibold">{{ t('settings.share_image') }}</label>
                    <select class="form-select{{ _self.invalid(errors, 'share_image') }}" id="settings-share_image" name="share_image"{{ _self.described(errors, 'share_image') }}>
                        <option value="">{{ t('settings.share_image_none') }}</option>
                        {% for image in images %}
                            <option value="{{ image.id }}"{{ form.share_image == image.id ~ '' ? ' selected' }}>{{ image.title ?: '#' ~ image.id }}{% if image.width and image.height %} ({{ image.width }}×{{ image.height }}){% endif %}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text" id="settings-share_image-help">
                        {{ t('settings.share_image_help') }}
                        {% if images is empty %}<a href="{{ admin_url('image') }}">{{ t('settings.share_image_upload') }}</a>{% endif %}
                    </div>
                    {{ _self.error(errors, 'share_image') }}
                </section>
            </div>
        </div>

        <div class="d-flex gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-primary">{{ t('admin.form.save') }}</button>
        </div>
    </form>
{% endblock %}
