{# The new password twice (a user's form, the profile). Never filled in again. #}
{% for name in ['password', 'password_again'] %}
    {% set message = errors[name] ?? null %}
    <div class="mb-3">
        <label for="{{ prefix }}-{{ name }}" class="form-label fw-semibold">{{ t(name == 'password' ? 'users.new_password' : 'users.password_again') }} <span class="text-danger" aria-hidden="true">*</span></label>
        <input type="password" class="form-control{{ message ? ' is-invalid' }}" id="{{ prefix }}-{{ name }}" name="{{ name }}" required autocomplete="new-password"
               aria-describedby="{{ message ? prefix ~ '-' ~ name ~ '-error' : (name == 'password' ? prefix ~ '-password-help' : '') }}">
        {% if name == 'password' %}<div class="form-text" id="{{ prefix }}-password-help">{{ t('users.password_help', {min: min_password}) }}</div>{% endif %}
        {% if message %}<div class="invalid-feedback" id="{{ prefix }}-{{ name }}-error">{{ t(message.key, message.params) }}</div>{% endif %}
    </div>
{% endfor %}
