{% extends '@core/admin/base.html.twig' %}
{% import '@core/admin/_blueprint_macros.html.twig' as m %}

{% block content %}
    <p class="small mb-1"><a href="{{ admin_url('system/blueprints') }}">{{ t('structure.blueprints') }}</a> › <a href="{{ admin_url('system/blueprints/' ~ blueprint.name) }}">{{ blueprint.label }}</a></p>
    <h1 class="h3 mb-2">{{ relation ? form.label : t('blueprints.relation_new') }}</h1>
    <p class="text-body-secondary mb-4">{{ t('blueprints.relation_intro') }}</p>

    {% if alert_text ?? null %}<div class="alert alert-danger" role="alert">{{ alert_text }}</div>{% endif %}

    <form method="post" action="{{ admin_url('system/blueprints/' ~ blueprint.name ~ '/relations/' ~ (relation ?: 'new')) }}" class="admin-form" novalidate>
        {{ csrf_field() }}
        <section class="card card-body mb-4">
            <div class="mb-3">
                <label for="bp-label" class="form-label fw-semibold">{{ t('blueprints.label') }} <span class="text-danger" aria-hidden="true">*</span></label>
                <input type="text" class="form-control{{ m.invalid(errors, 'label') }}" id="bp-label" name="label" value="{{ form.label }}" required maxlength="100">
                {{ m.error(errors, 'label') }}
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="bp-name" class="form-label fw-semibold">{{ t('blueprints.name') }} <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control font-monospace{{ m.invalid(errors, 'name') }}" id="bp-name" name="name" value="{{ form.name }}" maxlength="40" autocomplete="off"{{ relation ? ' disabled' : ' required' }}>
                    <div class="form-text">{{ t(relation ? 'blueprints.locked_help' : 'blueprints.field_name_help') }}</div>
                    {{ m.error(errors, 'name') }}
                </div>
                <div class="col-md-6">
                    <label for="bp-target" class="form-label fw-semibold">{{ t('blueprints.target') }} <span class="text-danger" aria-hidden="true">*</span></label>
                    <select class="form-select{{ m.invalid(errors, 'target') }}" id="bp-target" name="target"{{ relation ? ' disabled' : ' required' }}>
                        <option value="">{{ t('admin.form.none') }}</option>
                        {% for target in targets %}<option value="{{ target.name }}"{{ target.name == form.target ? ' selected' }}>{{ t(target.label) }}</option>{% endfor %}
                    </select>
                    {{ m.error(errors, 'target') }}
                </div>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="bp-many" name="many" value="1"{{ form.many ? ' checked' }}{{ relation ? ' disabled' }}>
                <label class="form-check-label" for="bp-many">{{ t('blueprints.many_help') }}</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="bp-required" name="required" value="1"{{ form.required ? ' checked' }}>
                <label class="form-check-label" for="bp-required">{{ t('blueprints.required') }}</label>
            </div>
        </section>
        <button type="submit" class="btn btn-primary">{{ t(relation ? 'admin.form.save' : 'blueprints.relation_add') }}</button>
        <a class="btn btn-link" href="{{ admin_url('system/blueprints/' ~ blueprint.name) }}">{{ t('blueprints.back') }}</a>
    </form>
{% endblock %}
