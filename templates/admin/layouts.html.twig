{% extends '@core/admin/base.html.twig' %}

{% macro error(errors, name) %}{% if errors[name] ?? null %}<div class="invalid-feedback d-block" id="layouts-{{ name|replace({'.': '-'}) }}-error">{{ t(errors[name].key, errors[name].params) }}</div>{% endif %}{% endmacro %}

{% macro look_label(value, look) %}{% if look.breakpoint is null %}{{ t('layouts.look.always') }}{% else %}{{ t('layouts.look.' ~ look.small, {breakpoint: t('layouts.breakpoint.' ~ look.breakpoint)}) }}{% endif %}{% endmacro %}

{% block content %}
    <h1 class="h3 mb-2">{{ t('layouts.title') }}</h1>
    <p class="text-body-secondary mb-4">{{ t('layouts.intro') }}</p>

    {% if not enabled %}<div class="alert alert-info" role="status" id="layouts-not-enabled">{{ t('layouts.not_enabled') }}</div>{% endif %}
    {% if alert ?? null %}<div class="alert alert-danger" role="alert">{{ t(alert) }}</div>{% endif %}
    {% for name, why in broken %}
        <div class="alert alert-warning" role="alert">{{ t('layouts.broken', {name: name}) }} <code>{{ why }}</code></div>
    {% endfor %}

    {# Since 0.4.10: the layouts, a sketch of each of rows, where each is used; those made here edited. #}
    <section class="mb-4" id="layouts-list">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h2 class="h5 mb-0 me-auto">{{ t('layouts.list') }}</h2>
            {% if can_make %}<a class="btn btn-primary btn-sm" href="{{ admin_url('system/layouts/new') }}">{{ t('layouts.editor.new') }}</a>{% endif %}
        </div>
        <div class="row g-3">
            {% for layout in layouts %}
                <div class="col-sm-6 col-lg-4 col-xxl-3" id="layouts-item-{{ layout.name }}">
                    <div class="card h-100">
                        <div class="card-body">
                            <h3 class="h6 mb-1">{{ t(layout.label) }}</h3>
                            <div class="small text-body-secondary mb-2">
                                <code>{{ layout.name }}</code> · {{ t('layouts.origin.' ~ layout.origin) }}
                                {% if layout.used %}· {{ t('layouts.used', {used: layout.used|map(u => u == 'site' ? t('layouts.editor.used_site') : u)|join(', ')}) }}{% endif %}
                            </div>
                            {% if layout.sketch %}
                                {{ include('@core/admin/_layout_sketch.html.twig', {rows: layout.sketch, mode: 'large'}) }}
                            {% else %}
                                <p class="small text-body-secondary mb-0">{{ t('layouts.own_template') }}</p>
                            {% endif %}
                        </div>
                        {% if layout.editable or layout.copyable %}
                            <div class="card-footer d-flex flex-wrap gap-2">
                                {% if layout.editable %}<a class="btn btn-sm btn-outline-primary" href="{{ admin_url('system/layouts/' ~ layout.name) }}">{{ t('layouts.editor.edit_short') }}</a>{% endif %}
                                {% if layout.copyable %}<a class="btn btn-sm btn-outline-secondary" href="{{ admin_url('system/layouts/new') }}?from={{ layout.name|url_encode }}">{{ t('layouts.editor.copy') }}</a>{% endif %}
                                {% if layout.editable %}<a class="btn btn-sm btn-outline-danger ms-auto" href="{{ admin_url('system/layouts/' ~ layout.name ~ '/delete') }}">{{ t('layouts.editor.delete_short') }}</a>{% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <form method="post" action="{{ admin_url('system/layouts') }}" class="admin-form" novalidate>
        {{ csrf_field() }}
        <div class="row g-4">
            <div class="col-xl-5">
                <fieldset class="card card-body mb-4">
                    <legend class="h6 mb-3">{{ t('layouts.site') }}</legend>
                    {% for layout in layouts %}
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="site" id="layouts-site-{{ layout.name }}" value="{{ layout.name }}"{{ form.site == layout.name ? ' checked' }} aria-describedby="layouts-site-{{ layout.name }}-regions">
                            <label class="form-check-label fw-semibold" for="layouts-site-{{ layout.name }}">{{ t(layout.label) }}</label>
                            {% if layout.origin == 'theme' %}<span class="badge text-bg-secondary ms-1">{{ t('layouts.from_theme') }}</span>{% elseif layout.origin == 'admin' %}<span class="badge text-bg-light border ms-1">{{ t('layouts.origin.admin') }}</span>{% endif %}
                            <div class="form-text" id="layouts-site-{{ layout.name }}-regions">{{ t('layouts.regions_list', {regions: layout.regions|map(r => t(r.label))|join(', ')}) }}</div>
                        </div>
                    {% endfor %}
                    {{ _self.error(errors, 'site') }}
                </fieldset>

                {% if blueprints %}
                    <section class="card card-body mb-4">
                        <h2 class="h6 mb-1">{{ t('layouts.blueprints') }}</h2>
                        <p class="form-text mt-0 mb-3">{{ t('layouts.blueprints_help') }}</p>
                        {% for blueprint in blueprints %}
                            {% set key = 'blueprint.' ~ blueprint.name %}
                            <div class="row g-2 align-items-center mb-2">
                                <label class="col-sm-5 col-form-label" for="layouts-bp-{{ blueprint.name }}">{{ t(blueprint.label) }}</label>
                                <div class="col-sm-7">
                                    <select class="form-select{{ (errors[key] ?? null) ? ' is-invalid' }}" id="layouts-bp-{{ blueprint.name }}" name="blueprint[{{ blueprint.name }}]">
                                        <option value="">{{ t('layouts.site_own') }}</option>
                                        {% for layout in layouts %}
                                            <option value="{{ layout.name }}"{{ form.blueprints[blueprint.name] == layout.name ? ' selected' }}>{{ t(layout.label) }}</option>
                                        {% endfor %}
                                    </select>
                                    {{ _self.error(errors, key) }}
                                </div>
                            </div>
                        {% endfor %}
                    </section>
                {% endif %}
            </div>

            <div class="col-xl-7">
                {% for layout in layouts %}
                    <section class="card card-body mb-4" id="layouts-looks-{{ layout.name }}">
                        <h2 class="h6 mb-1">{{ t('layouts.looks', {layout: t(layout.label)}) }}</h2>
                        <p class="form-text mt-0 mb-3">{{ t('layouts.looks_help') }}</p>
                        {% for region in layout.regions %}
                            {% set key = 'look.' ~ layout.name ~ '.' ~ region.name %}
                            <div class="row g-2 align-items-center mb-2">
                                <label class="col-sm-3 col-form-label" for="layouts-look-{{ layout.name }}-{{ region.name }}">{{ t(region.label) }}</label>
                                <div class="col-sm-9">
                                    <select class="form-select{{ (errors[key] ?? null) ? ' is-invalid' }}" id="layouts-look-{{ layout.name }}-{{ region.name }}" name="look[{{ layout.name }}][{{ region.name }}]">
                                        {% for value, look in looks %}
                                            <option value="{{ value }}"{{ form.looks[layout.name][region.name] == value ? ' selected' }}>{{ _self.look_label(value, look) }}{{ region.default == value ? ' · ' ~ t('layouts.look.default') }}</option>
                                        {% endfor %}
                                    </select>
                                    {{ _self.error(errors, key) }}
                                </div>
                            </div>
                        {% endfor %}
                    </section>
                {% endfor %}
            </div>
        </div>
        <button type="submit" class="btn btn-primary">{{ t('layouts.save') }}</button>
    </form>
{% endblock %}
