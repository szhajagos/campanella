{% extends '@core/admin/base.html.twig' %}

{# The modules of the site (since 0.4.6): found in the modules folder, checked, where each stands. #}
{% block content %}
    <h1 class="h3 mb-2">{{ t('modules.title') }}</h1>
    <p class="text-body-secondary mb-2">{{ t('modules.intro', {folder: directory}) }}</p>
    <p class="small text-body-secondary mb-4">{{ t('modules.trust') }}</p>

    {% if modules is empty %}
        <p class="text-body-secondary" id="modules-empty">{{ t('modules.empty', {folder: directory}) }}</p>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle admin-list" id="modules">
                <thead>
                    <tr>
                        <th scope="col">{{ t('modules.column.module') }}</th>
                        <th scope="col">{{ t('modules.column.version') }}</th>
                        <th scope="col">{{ t('modules.column.needs') }}</th>
                        <th scope="col">{{ t('modules.column.status') }}</th>
                        {% if can_change %}<th scope="col"><span class="visually-hidden">{{ t('modules.column.actions') }}</span></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for module in modules %}
                        <tr id="module-{{ module.name }}">
                            <td>
                                <span class="fw-semibold">{{ module.label }}</span> <code class="small text-body-secondary">{{ module.name }}</code>
                                {% if module.description %}<div class="small text-body-secondary">{{ module.description }}</div>{% endif %}
                            </td>
                            <td class="small text-nowrap">{{ module.version ?? '–' }}</td>
                            <td class="small">
                                {% if module.campanella %}<div>Campanella <code>{{ module.campanella }}</code></div>{% endif %}
                                {% for other, constraint in module.requires %}<div>{{ other }} <code>{{ constraint }}</code></div>{% endfor %}
                            </td>
                            <td>
                                {% set badge = {broken: 'text-bg-danger', off: 'text-bg-light border', on: 'text-bg-success', not_loaded: 'text-bg-warning'}[module.status] %}
                                <span class="badge {{ badge }} fw-normal">{{ t('modules.status.' ~ module.status) }}</span>
                                {% for problem in module.problems %}<div class="small {{ module.status == 'broken' ? 'text-danger' : 'text-body-secondary' }}">{{ t(problem.key, problem.params) }}</div>{% endfor %}
                                {% if module.failure %}<div class="small text-danger" id="module-{{ module.name }}-failure">{{ t(module.failure.key, module.failure.params) }}</div>{% endif %}
                            </td>
                            {% if can_change %}
                                <td class="text-end text-nowrap">
                                    {% if module.enabled %}
                                        <form method="post" action="{{ admin_url('system/modules/' ~ module.name ~ '/disable') }}" class="d-inline">
                                            {{ csrf_field() }}
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="{{ t('modules.disable_label', {label: module.label}) }}">{{ t('modules.disable') }}</button>
                                        </form>
                                    {% elseif module.status == 'off' %}
                                        <a class="btn btn-sm btn-primary" href="{{ admin_url('system/modules/' ~ module.name ~ '/enable') }}" aria-label="{{ t('modules.enable_label', {label: module.label}) }}">{{ t('modules.enable') }}</a>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
