{# One of the field's choices (since 0.2.2). #}
<select class="form-select{{ invalid }}" id="{{ input_id }}" name="{{ field.inputName }}"{% if field.required and not field.multiple %} required{% endif %}{% if field.disabled %} disabled{% endif %}>
    <option value="">{{ t('admin.form.none') }}</option>
    {% for option in field.options %}
        <option value="{{ option.value }}"{{ option.value == value ? ' selected' }}>{{ option.label }}</option>
    {% endfor %}
</select>
