{% extends '@core/admin/base.html.twig' %}

{% block content %}
    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
        <h1 class="h3 mb-0">{{ t('users.title') }}</h1>
        <div class="d-flex align-items-center gap-3">
            <span class="text-body-secondary small">{{ t('admin.list.total', {count: users|length}) }}</span>
            <a class="btn btn-sm btn-primary" href="{{ admin_url('user/new') }}">{{ t('users.new') }}</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle admin-list">
            <thead>
                <tr>
                    <th scope="col">{{ t('users.name') }}</th>
                    <th scope="col">{{ t('field.email') }}</th>
                    <th scope="col">{{ t('field.roles') }}</th>
                    <th scope="col">{{ t('field.account_status') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr id="row-{{ user.id }}">
                        <td>
                            <a class="fw-semibold" href="{{ admin_url('user/' ~ user.id) }}">{{ user.name }}</a>
                            {% if user.id == self %}<span class="badge bg-body-tertiary text-body-secondary border fw-normal ms-1">{{ t('users.you') }}</span>{% endif %}
                        </td>
                        <td class="small">{{ user.email }}</td>
                        <td class="small">
                            {%- for role in user.roles -%}
                                {{ loop.first ? '' : ', ' }}{% include '@core/admin/_role.html.twig' with {role: role} only %}
                            {%- else -%}
                                <span class="text-body-secondary">–</span>
                            {%- endfor -%}
                        </td>
                        <td>
                            {% if user.active %}
                                <span class="badge text-bg-success">{{ t('users.status.active') }}</span>
                            {% else %}
                                <span class="badge text-bg-secondary">{{ t('users.status.blocked') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
