{# Short rendering in lists. #}
<article class="object object--teaser object--{{ object.blueprint }} py-3 border-bottom">
    <h2 class="h4 mb-1"><a class="text-reset text-decoration-none" href="{{ url(object.path) }}">{{ object.title }}</a></h2>
    {% if object.published_at is defined and object.published_at %}
        <p class="meta small text-body-secondary mb-2"><time datetime="{{ object.published_at|date('c') }}">{{ object.published_at|date }}</time></p>
    {% endif %}
    {% if object.lead is defined and object.lead %}
        <p class="mb-2">{{ object.lead }}</p>
    {% endif %}
    {{ include('object/_relations.html.twig') }}
    <a class="more small" href="{{ url(object.path) }}">{{ t('content.more') }}</a>
</article>
