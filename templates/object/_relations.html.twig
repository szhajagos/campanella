{# The object's relations as links, e.g. "Kategóriák: Tudomány, Campanella".
   The targets are loaded by the controller (RelationLoader); targets that are not visible are left out. #}
{% for name, relation in object.relations %}
    {% set items = related(object, name) %}
    {% if items %}
        <p class="relations relations--{{ name }} small text-body-secondary mb-2">
            <span class="relations__label">{{ t(relation.label ?: name) }}:</span>
            {% for item in items -%}
                {%- if not loop.first %}, {% endif -%}
                {%- set label = item.title is defined and item.title ? item.title : '#' ~ item.id -%}
                {%- if item.path is defined and item.path -%}
                    <a href="{{ url(item.path) }}">{{ label }}</a>
                {%- else -%}
                    {{ label }}
                {%- endif -%}
            {%- endfor %}
        </p>
    {% endif %}
{% endfor %}
