# All text files use LF line endings in the repository and in the working tree,
# on Windows too (regardless of the core.autocrlf setting). Campanella runs on
# Linux: CRLF would e.g. break running bin/campanella ("php\r").
* text=auto eol=lf

# Binary files: never convert.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary

# Excluded from the release package (git archive): development tools.
/.github        export-ignore
/tests          export-ignore
/phpstan.neon   export-ignore
/.gitattributes export-ignore
